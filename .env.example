# Site (public — shipped to client bundle)
VITE_PUBLIC_SITE_URL=https://interactivedisplays.ie

# Node runtime
NODE_ENV=production
PORT=3417
HOST=127.0.0.1

# Microsoft 365 Graph API — outbound email for contact form notifications
# Auth via OAuth2 client credentials flow against an Azure AD app registration
# with Mail.Send application permission (admin-consented).
# See docs/PLESK_DEPLOY.md "M365 Graph setup" for the Entra admin walkthrough.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=sales@interactivedisplays.ie
LEAD_RECIPIENT=sales@interactivedisplays.ie

# Odoo — CRM and Live Chat (server-only secrets, not wired up yet)
ODOO_BASE_URL=https://your-odoo-instance.example.com
ODOO_DB=your_database_name
ODOO_API_KEY=

# Odoo Live Chat — public values (shipped to every visitor's browser as the
# im_livechat script src). Setting these enables the chat widget on every
# TanStack route AND every mirror-served page (start-node.mjs injects the
# same two script tags into legacy HTML responses before </body>).
VITE_PUBLIC_ODOO_BASE_URL=https://erp.interpos.ai
VITE_PUBLIC_ODOO_LIVECHAT_CHANNEL_ID=4

# Optional — analytics, monitoring
# VITE_PUBLIC_PLAUSIBLE_DOMAIN=interactivedisplays.ie
# SENTRY_DSN=
