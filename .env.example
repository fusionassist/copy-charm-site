# Site (public — shipped to client bundle)
VITE_PUBLIC_SITE_URL=https://interactivedisplays.ie

# Node runtime
NODE_ENV=production
PORT=3417
HOST=127.0.0.1

# Microsoft 365 SMTP — outbound email for contact form notifications
# Auth as a real user mailbox (with Send As permission on SMTP_FROM if it's a shared mailbox).
# Generate the password as an M365 App Password (Security → Additional security verification → App passwords).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=gerry@interactivedisplays.ie
SMTP_PASS=
SMTP_FROM=sales@interactivedisplays.ie
LEAD_RECIPIENT=sales@interactivedisplays.ie

# Odoo — CRM and Live Chat (server-only secrets, not wired up yet)
ODOO_BASE_URL=https://your-odoo-instance.example.com
ODOO_DB=your_database_name
ODOO_API_KEY=

# Odoo Live Chat channel — may be exposed to client if widget is loaded in-page
VITE_PUBLIC_ODOO_LIVECHAT_CHANNEL_ID=
VITE_PUBLIC_ODOO_BASE_URL=

# Resend — alternative/fallback email provider (not used; M365 SMTP is primary)
# RESEND_API_KEY=
# RESEND_FALLBACK_INBOX=leads@interactivedisplays.ie

# Optional — analytics, monitoring
# VITE_PUBLIC_PLAUSIBLE_DOMAIN=interactivedisplays.ie
# SENTRY_DSN=
