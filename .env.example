# Site (public — shipped to client bundle)
VITE_PUBLIC_SITE_URL=https://interactivedisplays.ie

# Node runtime
NODE_ENV=production
PORT=3417
HOST=127.0.0.1

# Microsoft 365 Graph API — outbound email for contact form notifications
# Auth via OAuth2 client credentials flow against an Azure AD app registration
# with Mail.Send application permission (admin-consented).
# See docs/PLESK_DEPLOY.md "M365 Graph setup" for the Entra admin walkthrough.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_SENDER=sales@interactivedisplays.ie
LEAD_RECIPIENT=sales@interactivedisplays.ie

# Odoo — CRM and Live Chat (server-only secrets, not wired up yet)
ODOO_BASE_URL=https://your-odoo-instance.example.com
ODOO_DB=your_database_name
ODOO_API_KEY=

# Odoo Live Chat — public values (shipped to every visitor's browser as the
# im_livechat script src). Setting these enables the chat widget on every
# TanStack route AND every mirror-served page (start-node.mjs injects the
# same two script tags into legacy HTML responses before </body>).
VITE_PUBLIC_ODOO_BASE_URL=https://erp.interpos.ai
VITE_PUBLIC_ODOO_LIVECHAT_CHANNEL_ID=4

# Tracking & analytics — all public, all optional. Setting any single one
# activates only that tracker; they're independent. Each script is
# injected on every TanStack route AND every mirror-served page.
#
# Google Tag Manager (preferred — one container, manage all tags inside GTM)
VITE_PUBLIC_GTM_ID=
#
# Google Analytics 4 (direct gtag.js — alternative to GTM)
VITE_PUBLIC_GA4_ID=
#
# Google Ads conversion tracking (direct gtag.js — alternative to GTM).
# Set send_to in your Google Ads conversion action UI; the lib/track.ts
# helper emits generate_lead / phone_call / email_click events that map
# to standard GA4 events.
VITE_PUBLIC_GOOGLE_ADS_ID=
#
# Meta Pixel (Facebook + Instagram ads)
VITE_PUBLIC_META_PIXEL_ID=
#
# LinkedIn Insight Tag (B2B ads)
VITE_PUBLIC_LINKEDIN_PARTNER_ID=

# Google reCAPTCHA v3 — invisible, score-based spam protection on the
# contact form (/api/contact) and the legacy careers form bridge
# (/wp-admin/admin-ajax.php). Both vars must be set to activate; with
# either unset, forms submit without verification (dev-friendly).
# Create keys (reCAPTCHA v3, domains: interactivedisplays.ie +
# beta.interactivedisplays.ie) at https://www.google.com/recaptcha/admin/create
VITE_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Reject submissions scoring below this (0.0 bot – 1.0 human; Google
# recommends starting at 0.5). Optional.
# RECAPTCHA_MIN_SCORE=0.5

# Optional — analytics, monitoring
# VITE_PUBLIC_PLAUSIBLE_DOMAIN=interactivedisplays.ie
# SENTRY_DSN=
