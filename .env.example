# Site (public — shipped to client bundle)
VITE_PUBLIC_SITE_URL=https://interactivedisplays.ie

# Odoo — CRM and Live Chat (server-only secrets)
ODOO_BASE_URL=https://your-odoo-instance.example.com
ODOO_DB=your_database_name
ODOO_API_KEY=

# Odoo Live Chat channel — may be exposed to client if widget is loaded in-page
VITE_PUBLIC_ODOO_LIVECHAT_CHANNEL_ID=
VITE_PUBLIC_ODOO_BASE_URL=

# Resend — Email fallback when Odoo is unreachable (server-only)
RESEND_API_KEY=
RESEND_FALLBACK_INBOX=leads@interactivedisplays.ie

# Optional — analytics, monitoring
# VITE_PUBLIC_PLAUSIBLE_DOMAIN=interactivedisplays.ie
# SENTRY_DSN=
