et\" data-widget_type=\"image.default\">\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<img decoding=\"async\" width=\"428\" height=\"428\" src=\"https:\/\/www.interactivedisplays.ie\/wp-content\/uploads\/2025\/06\/ticket-virtuel-ticket-appel.png\" class=\"attachment-large size-large wp-image-1320\" alt=\"digital-smartphone-ticket\" srcset=\"https:\/\/www.interactivedisplays.ie\/wp-content\/uploads\/2025\/06\/ticket-virtuel-ticket-appel.png 428w, https:\/\/www.interactivedisplays.ie\/wp-content\/uploads\/2025\/06\/ticket-virtuel-ticket-appel-300x300.png 300w, https:\/\/www.interactivedisplays.ie\/wp-content\/uploads\/2025\/06\/ticket-virtuel-ticket-appel-150x150.png 150w, https:\/\/www.interactivedisplays.ie\/wp-content\/uploads\/2025\/06\/ticket-virtuel-ticket-appel-100x100.png 100w\" sizes=\"(max-width: 428px) 100vw, 428px\" \/>\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div id=\"e-n-tab-content-6568794942\" role=\"tabpanel\" aria-labelledby=\"e-n-tab-title-6568794942\" data-tab-index=\"2\" style=\"--n-tabs-title-order: 2;\" class=\" elementor-element elementor-element-40bd0976 e-con-full e-flex wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no e-con e-child\" data-id=\"40bd0976\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-16fbb4c0 e-con-full e-flex wpr-particle-no wpr-jarallax-no wpr-parallax-no wpr-sticky-section-no e-con e-child\" data-id=\"16fbb4c0\" data-element_type=\"container\" data-e-type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-32087d10 elementor-widget elementor-widget-heading\" data-id=\"32087d10\" data-element_type=\"widget\" data-e-type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Digital ticket with a QRcode\n<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-5c6b08ae elementor-widget elementor-widget-text-e